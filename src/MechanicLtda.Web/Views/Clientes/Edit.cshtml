@model ClienteFormViewModel
@{
    ViewData["Title"] = "Editar cliente";
}

<section class="page-header">
    <div>
        <h1>Editar cliente</h1>
        <p>Atualize os dados cadastrais e o status.</p>
    </div>
</section>

<form class="form" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_ValidationSummary" />
    <div class="form-grid">
        <div class="field"><label asp-for="Nome"></label><input asp-for="Nome" /><span asp-validation-for="Nome"></span></div>
        <div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
        <div class="field"><label asp-for="Telefone"></label><input asp-for="Telefone" /><span asp-validation-for="Telefone"></span></div>
        <div class="field"><label asp-for="CpfCnpj">CPF/CNPJ</label><input asp-for="CpfCnpj" /><span asp-validation-for="CpfCnpj"></span></div>
        <label class="checkbox"><input asp-for="Ativo" /> Ativo</label>
    </div>
    <div class="form-actions">
        <button class="btn" type="submit">Salvar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

