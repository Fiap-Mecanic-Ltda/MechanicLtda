@model EstoqueReposicaoRazorViewModel
@{
    ViewData["Title"] = "Repor estoque";
}

<section class="page-header">
    <div><h1>Repor estoque</h1><p>@Model.Nome</p></div>
</section>

<form class="form" asp-action="Repor" asp-route-id="@Model.Id" method="post">
    <partial name="_ValidationSummary" />
    <input asp-for="Id" type="hidden" />
    <input asp-for="Nome" type="hidden" />
    <div class="form-grid">
        <div class="field"><label asp-for="QuantidadeEntrada">Quantidade de entrada</label><input asp-for="QuantidadeEntrada" type="number" /><span asp-validation-for="QuantidadeEntrada"></span></div>
    </div>
    <div class="form-actions"><button class="btn" type="submit">Confirmar reposição</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
</form>


