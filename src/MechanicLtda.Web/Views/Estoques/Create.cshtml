@model EstoqueFormViewModel
@{
    ViewData["Title"] = "Novo item de estoque";
}

<section class="page-header">
    <div><h1>Novo item</h1><p>Cadastre peças ou insumos usados na oficina.</p></div>
</section>

<form class="form" asp-action="Create" method="post">
    <partial name="_ValidationSummary" />
    <div class="form-grid">
        <div class="field field-full"><label asp-for="Nome"></label><input asp-for="Nome" /><span asp-validation-for="Nome"></span></div>
        <div class="field"><label asp-for="Tipo"></label><select asp-for="Tipo" asp-items="Model.Tipos"></select><span asp-validation-for="Tipo"></span></div>
        <div class="field"><label asp-for="QuantidadeAtual">Quantidade atual</label><input asp-for="QuantidadeAtual" type="number" /><span asp-validation-for="QuantidadeAtual"></span></div>
        <div class="field"><label asp-for="QuantidadeMinima">Quantidade mínima</label><input asp-for="QuantidadeMinima" type="number" /><span asp-validation-for="QuantidadeMinima"></span></div>
    </div>
    <div class="form-actions"><button class="btn" type="submit">Salvar</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
</form>

