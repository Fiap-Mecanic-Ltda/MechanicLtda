@model OrdemServicoFormViewModel
@{
    ViewData["Title"] = "Nova ordem de serviço";
}

<section class="page-header">
    <div><h1>Nova ordem de serviço</h1><p>Registre o problema relatado e associe cliente e veículo.</p></div>
</section>

<form class="form" asp-action="Create" method="post">
    <partial name="_ValidationSummary" />
    <div class="form-grid">
        <div class="field"><label asp-for="ClienteId">Cliente</label><select asp-for="ClienteId" asp-items="Model.Clientes"><option value="">Selecione</option></select><span asp-validation-for="ClienteId"></span></div>
        <div class="field"><label asp-for="VeiculoId">Veículo</label><select asp-for="VeiculoId" asp-items="Model.Veiculos"><option value="">Selecione</option></select><span asp-validation-for="VeiculoId"></span></div>
        <div class="field"><label asp-for="ValorTotalEstimado">Valor estimado</label><input asp-for="ValorTotalEstimado" type="number" step="0.01" /><span asp-validation-for="ValorTotalEstimado"></span></div>
        <div class="field field-full"><label asp-for="DescricaoProblema">Descrição do problema</label><textarea asp-for="DescricaoProblema"></textarea><span asp-validation-for="DescricaoProblema"></span></div>
    </div>
    <div class="form-actions"><button class="btn" type="submit">Abrir ordem</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
</form>

