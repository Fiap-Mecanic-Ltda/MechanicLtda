<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Mechanic Ltda</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">Mechanic Ltda</a>
        <nav class="navlinks" aria-label="Principal">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Clientes" asp-action="Index">Clientes</a>
                <a asp-controller="Veiculos" asp-action="Index">Veículos</a>
                <a asp-controller="OrdensServico" asp-action="Index">Ordens</a>
                <a asp-controller="ServicosOficina" asp-action="Index">Serviços</a>
                <a asp-controller="Estoques" asp-action="Index">Estoque</a>
                <form class="logout-form" asp-controller="Conta" asp-action="Logout" method="post">
                    <button type="submit">Sair</button>
                </form>
            }
            else
            {
                <a asp-controller="Conta" asp-action="Login">Login</a>
            }
            <a id="swagger-link" href="#" target="_blank" rel="noopener">API</a>
        </nav>
    </header>

    <script>
        // Web e API rodam em containers/pods separados, cada um na sua própria
        // porta do mesmo host (8090 Web / 8080 API - ver docker-compose.yml e
        // k8s/overlays/prod/kustomization.yaml). Um href="/swagger" fixo
        // resolveria contra a origem do próprio Web (porta 8090, sem Swagger),
        // não da API - por isso o link é montado em runtime a partir do
        // hostname atual, trocando só a porta.
        document.getElementById('swagger-link').href =
            window.location.protocol + '//' + window.location.hostname + ':8080/swagger';
    </script>

    <main class="shell">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>

