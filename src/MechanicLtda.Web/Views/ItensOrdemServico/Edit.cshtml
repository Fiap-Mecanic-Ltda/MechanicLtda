@model ItemOrdemServicoFormViewModel
@{
    ViewData["Title"] = "Editar item";
}

<section class="page-header">
    <div><h1>Editar item</h1><p>Ordem de servi&ccedil;o #@Model.OrdemServicoId</p></div>
</section>

<form class="form" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_ValidationSummary" />
    <input asp-for="OrdemServicoId" type="hidden" />
    <div class="form-grid">
        <div class="field field-full"><label asp-for="ServicoOficinaId">Servi&ccedil;o cadastrado</label><select asp-for="ServicoOficinaId" asp-items="Model.ServicosOficina"><option value="">Sem servi&ccedil;o cadastrado</option></select><span asp-validation-for="ServicoOficinaId"></span></div>
        <div class="field field-full"><label asp-for="DescricaoServico">Descri&ccedil;&atilde;o do servi&ccedil;o</label><textarea asp-for="DescricaoServico" rows="3"></textarea><span asp-validation-for="DescricaoServico"></span></div>
        <div class="field field-full"><label asp-for="EstoqueId">Estoque usado</label><select asp-for="EstoqueId" asp-items="Model.Estoques"><option value="">Sem item de estoque</option></select><span asp-validation-for="EstoqueId"></span></div>
        <div class="field"><label asp-for="Quantidade"></label><input asp-for="Quantidade" type="number" /><span asp-validation-for="Quantidade"></span></div>
        <div class="field"><label asp-for="ValorUnitario">Valor unit&aacute;rio</label><input asp-for="ValorUnitario" type="number" step="0.01" /><span asp-validation-for="ValorUnitario"></span></div>
    </div>
    <div class="form-actions"><button class="btn" type="submit">Salvar</button><a class="btn btn-secondary" asp-controller="OrdensServico" asp-action="Details" asp-route-id="@Model.OrdemServicoId">Cancelar</a></div>
</form>
