{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MechanicLtdaDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "MechanicLtda.API",
    "IssuerCpf": "MechanicLtda.Auth.Cpf",
    "Audience": "MechanicLtda.Clients",
    "ExpiracaoMinutos": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Integracoes": {
    "SagaHabilitada": true,
    "OsService": {
      "BaseUrl": "http://localhost:8081",
      "TimeoutSegundos": 10
    },
    "ExecucaoService": {
      "BaseUrl": "http://localhost:8082",
      "TimeoutSegundos": 10
    }
  },
  "Encryption": {
    "CpfCnpjKey": "SUA_CHAVE_SECRETA_AQUI_MIN_32_CHARS",
    "CpfCnpjHashKey": "SUA_CHAVE_DE_HASH_AQUI_MIN_32_CHARS"
  }
}
